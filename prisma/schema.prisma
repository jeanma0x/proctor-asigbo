// ASIGBO Proctoring - Prisma schema (PostgreSQL / Neon.tech)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon pgbouncer) for runtime queries
  url       = env("DATABASE_URL")
  // Direct connection for migrations
  directUrl = env("DIRECT_URL")
}

// ───────────── Enums ─────────────

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TEXT
}

enum SessionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  TERMINATED // cerrada por la Junta / fraude
}

enum AuditEventType {
  SESSION_START
  SESSION_SUBMIT
  TAB_CHANGE
  WINDOW_BLUR
  FULLSCREEN_EXIT
  PASTE_ATTEMPT
  COPY_ATTEMPT
  CUT_ATTEMPT
  CONTEXT_MENU
  OTHER
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AdminRole {
  SUPERADMIN // todo, incluida la gestión de administradores
  ADMIN // opera exámenes, accesos, monitoreo, resultados y convocatorias
  REVIEWER // solo lectura: dashboard, monitoreo y resultados
}

enum SelectionDecision {
  SELECTED
  WAITLIST
  NOT_SELECTED
}

enum ConvocatoriaStatus {
  ACTIVE
  ARCHIVED
}

// ───────────── Models ─────────────

/// Convocatoria anual de becas (p. ej. «Convocatoria 2027»). Agrupa exámenes y conserva el histórico por año.
model Convocatoria {
  id          String             @id @default(cuid())
  name        String
  year        Int
  description String?
  status      ConvocatoriaStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  exams Exam[]

  @@index([year])
}

model Candidate {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  /// Carné o identificador del aspirante
  studentId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions CandidateSession[]
  notes    CandidateNote[]
}

/// Notas internas de la Junta sobre un candidato (histórico entre convocatorias)
model CandidateNote {
  id          String   @id @default(cuid())
  candidateId String
  authorId    String?
  authorName  String
  body        String
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
}

model Exam {
  id              String     @id @default(cuid())
  title           String
  description     String?
  /// Duración en minutos
  durationMinutes Int        @default(60)
  status          ExamStatus @default(DRAFT)
  opensAt         DateTime?
  closesAt        DateTime?
  convocatoriaId  String?
  /// Cada candidato ve las preguntas en un orden distinto (determinista por sesión)
  shuffleQuestions Boolean   @default(false)
  /// Ídem para las opciones de las preguntas de opción múltiple
  shuffleOptions   Boolean   @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  /// Restrict: no se puede borrar una convocatoria con exámenes (el histórico persiste)
  convocatoria Convocatoria? @relation(fields: [convocatoriaId], references: [id], onDelete: Restrict)
  questions    Question[]
  sessions     CandidateSession[]

  @@index([convocatoriaId])
}

model Question {
  id       String       @id @default(cuid())
  examId   String
  text     String
  type     QuestionType @default(MULTIPLE_CHOICE)
  imageUrl String?
  /// Orden de aparición en el examen
  position Int          @default(0)
  points   Int          @default(1)

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  options Option[]
  answers Answer[]

  @@index([examId, position])
}

model Option {
  id         String  @id @default(cuid())
  questionId String
  text       String
  imageUrl   String?
  isCorrect  Boolean @default(false)
  position   Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  Answer[]

  @@index([questionId])
}

model CandidateSession {
  id          String        @id @default(cuid())
  candidateId String
  examId      String
  status      SessionStatus @default(NOT_STARTED)
  startedAt   DateTime?
  submittedAt DateTime?
  score       Float?
  /// Contador denormalizado de incidencias para el dashboard en vivo
  flagCount   Int           @default(0)
  /// Última vez que se envió la invitación por correo
  emailSentAt DateTime?
  /// Decisión de la Junta tras el ranking (histórico de seleccionados por convocatoria)
  decision    SelectionDecision?
  decidedAt   DateTime?
  /// Quién tomó la decisión (correo del administrador)
  decidedBy   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  candidate Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// Restrict: un examen con sesiones no se puede borrar (conserva resultados históricos)
  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Restrict)
  answers   Answer[]
  auditLogs AuditLog[]

  @@unique([candidateId, examId])
  @@index([status])
}

/// Respuesta del candidato (necesaria para calificar)
model Answer {
  id               String   @id @default(cuid())
  sessionId        String
  questionId       String
  selectedOptionId String?
  textResponse     String?
  /// Calificación manual (preguntas abiertas): 0..puntos de la pregunta. null = pendiente.
  manualScore      Float?
  gradedAt         DateTime?
  /// Quién calificó (correo del administrador)
  gradedBy         String?
  answeredAt       DateTime @default(now())

  session        CandidateSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question       Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Option?          @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([sessionId, questionId])
}

model AuditLog {
  id        String         @id @default(cuid())
  sessionId String
  type      AuditEventType
  severity  AuditSeverity  @default(WARNING)
  details   String?
  createdAt DateTime       @default(now())

  session CandidateSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([type, createdAt])
}

/// Administradores de la Junta Directiva (acceso al panel /admin)
model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  passwordHash       String
  role               AdminRole @default(ADMIN)
  /// false = acceso desactivado (no puede ingresar; se conserva el usuario)
  isActive           Boolean   @default(true)
  /// Se incrementa al cambiar/restablecer la contraseña o cerrar sesiones: invalida los JWT emitidos antes.
  tokenVersion       Int       @default(0)
  /// true cuando la contraseña es temporal (usuario nuevo o restablecida por otro admin).
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
}

/// Bitácora de acciones de los administradores (inmutable: solo se escribe y se consulta).
model AdminActionLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String
  actorName  String?
  /// Clave de la acción: «decision.set», «exam.update», «user.create», etc. (el prefijo es la categoría)
  action     String
  entityType String
  entityId   String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

/// Intentos fallidos de login (límite de intentos por correo e IP; sirve en entornos serverless).
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}
